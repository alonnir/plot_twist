{
  "hosting": {
    "predeploy": ["node bump-version.js"],
    "site": "plot-twist",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".*",
      ".*/**",
      "**/.*",
      "**/node_modules/**",
      "firebase-debug.log",
      "*.log",
      "bump-version.js",
      "CLAUDE.md",
      "AGENTS.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|svg|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=86400"
          }
        ]
      }
    ]
  }
}
